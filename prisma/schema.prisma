generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (miroir des unions TypeScript de src/types.ts) ----------

enum RegimeFiscal {
  REEL_SIMPLIFIE      @map("Réel Simplifié")
  REEL_NORMAL         @map("Réel Normal")
  SYNTHETIQUE_FORFAIT @map("Synthétique / Forfait")
}

enum UserRole {
  ADMIN
  COMPTABLE
  LECTURE_SEULE
}

enum AccountCategory {
  bilan_actif
  bilan_passif
  charge
  produit
  tresorerie
}

enum TransactionStatus {
  validated
  pending_review
  anomaly
}

enum InputMode {
  text
  voice
  photo
  mobile_money
  manual
  excel_import
}

enum PaymentMethod {
  cash
  orange_money
  mtn_momo
  wave
  moov_money
  bank_transfer
  cheque
}

enum AuditAction {
  created_by_ai
  validated_by_expert
  auto_validated
  edited_by_expert
  anomaly_flagged
}

enum NotificationType {
  info
  success
  warning
  error
}

enum NotificationCategory {
  compta
  fiscal
  tresorerie
  ia
  system
}

enum AiModelPreference {
  GEMINI_2_5_FLASH      @map("gemini-2.5-flash")
  GEMINI_2_5_FLASH_LITE @map("gemini-2.5-flash-lite")
  HEURISTIC_FAST        @map("heuristic-fast")
}

enum StartupView {
  simplified
  expert
}

enum NumberFormatting {
  standard
  compact
}

enum SoundType {
  fintech_chime
  crystal_bell
  soft_chord
  alert_warning
}

// ---------- Modèles ----------

model ClientDossier {
  id                  String       @id @default(uuid())
  name                String
  managerName         String
  phone               String
  activity            String
  city                String
  country             String
  rccm                String
  ifu                 String
  regimeFiscal        RegimeFiscal
  confidenceThreshold Int          @default(85)
  currency            String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  journalEntries JournalEntry[]
  notifications  AppNotification[]

  @@map("client_dossiers")
}

model SyscohadaAccount {
  code        String          @id
  label       String
  classNumber Int
  category    AccountCategory

  debitEntries  JournalEntry[] @relation("DebitAccount")
  creditEntries JournalEntry[] @relation("CreditAccount")

  @@map("syscohada_accounts")
}

model JournalEntry {
  id                     String            @id @default(uuid())
  date                   DateTime          @db.Date
  label                  String
  pieceRef               String
  debitAccountCode       String
  debitAccount           SyscohadaAccount  @relation("DebitAccount", fields: [debitAccountCode], references: [code])
  creditAccountCode      String
  creditAccount          SyscohadaAccount  @relation("CreditAccount", fields: [creditAccountCode], references: [code])
  amount                 Decimal           @db.Decimal(14, 2)
  tvaAmount              Decimal           @db.Decimal(14, 2)
  clientDossierId        String
  clientDossier          ClientDossier     @relation(fields: [clientDossierId], references: [id], onDelete: Cascade)
  status                 TransactionStatus @default(pending_review)
  confidenceScore        Int
  detectedAnomaly        String?
  rawInput               String
  inputType              InputMode
  explanationSimplified  String
  paymentMethod          PaymentMethod
  createdAt              DateTime          @default(now())

  auditTrail AuditLog[]

  @@index([clientDossierId])
  @@map("journal_entries")
}

model AuditLog {
  id              String       @id @default(uuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  timestamp       DateTime     @default(now())
  action          AuditAction
  author          String
  notes           String?
  previousValue   String?
  confidenceScore Int?

  @@index([journalEntryId])
  @@map("audit_logs")
}

model AppNotification {
  id              String                @id @default(uuid())
  title           String
  message         String
  timestamp       DateTime              @default(now())
  type            NotificationType
  category        NotificationCategory
  read            Boolean               @default(false)
  dossierId       String?
  dossier         ClientDossier?        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  actionLabel     String?
  actionMode      StartupView?
  actionExpertTab String?

  @@index([dossierId])
  @@map("app_notifications")
}

// Réglages globaux de la plateforme (une seule ligne applicative)
model PlatformSettings {
  id                          String            @id @default(uuid())
  syscohadaVersion            String
  cashDeductibilityThreshold  Decimal           @db.Decimal(14, 2)
  defaultVatRate              Decimal           @db.Decimal(5, 2)
  autoFlagLargeCashPayments   Boolean
  defaultDebitCashAccount     String
  defaultCreditSalesAccount   String
  defaultDebitExpenseAccount  String
  globalConfidenceThreshold   Int
  autoValidateHighConfidence  Boolean
  duplicateDetection          Boolean
  aiModelPreference           AiModelPreference
  defaultStartupView          StartupView
  numberFormatting            NumberFormatting
  cabinetName                 String
  expertLicenseNumber         String
  soundEnabled                Boolean
  soundType                   SoundType
  soundVolume                 Float
  notifyOnAnomaly             Boolean
  notifyOnTaxDeadline         Boolean
  notifyOnMobileMoneySync     Boolean
  updatedAt                   DateTime          @updatedAt

  @@map("platform_settings")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(COMPTABLE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
